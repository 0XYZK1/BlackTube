<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nexus" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/nexus_black</item>
        <item name="colorPrimaryDark">@color/nexus_black</item>
        <item name="colorAccent">@color/nexus_white</item>
        <item name="android:windowBackground">@color/nexus_black</item>
        <item name="android:statusBarColor">@color/nexus_black</item>
        <item name="android:navigationBarColor">@color/nexus_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:colorBackground">@color/nexus_black</item>
        <item name="alertDialogTheme">@style/Theme.Nexus.Dialog</item>
    </style>

    <style name="Theme.Nexus.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/nexus_white</item>
        <item name="android:colorBackground">#0C0C0C</item>
        <item name="android:windowBackground">#0C0C0C</item>
    </style>

    <style name="Theme.Nexus.BottomSheet" parent="Theme.Design.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/NexusBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#0C0C0C</item>
    </style>

    <style name="NexusBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="NexusRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">@color/nexus_white</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="NexusTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/nexus_text_dim</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@null</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="NexusButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/nexus_white</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>
</resources>
